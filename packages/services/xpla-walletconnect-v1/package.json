{
	"name": "@trustwallet/connect-xpla-walletconnect-v1",
	"version": "0.0.0",
	"description": "WalletConnect v1 service for XPLA Vault Mobile (TrustConnect SDK)",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./react": {
			"types": "./dist/react/index.d.ts",
			"import": "./dist/react/index.js"
		}
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"clean": "rm -rf dist",
		"test": "vitest run"
	},
	"dependencies": {
		"@trustwallet/connect-core": "workspace:*",
		"@trustwallet/connect-cosmos-types": "workspace:*",
		"@walletconnect/core": "1.6.6",
		"@walletconnect/iso-crypto": "1.6.6",
		"@walletconnect/types": "1.6.6",
		"@walletconnect/utils": "1.6.6"
	},
	"peerDependencies": {
		"@trustwallet/connect-headless": "workspace:*",
		"cosmjs-types": "^0.9.0",
		"react": "^18.0.0 || ^19.0.0"
	},
	"peerDependenciesMeta": {
		"cosmjs-types": {
			"optional": true
		},
		"react": {
			"optional": true
		}
	},
	"devDependencies": {
		"@trustwallet/connect-cosmos-core": "workspace:*",
		"@trustwallet/connect-headless": "workspace:*",
		"@types/react": "19.2.7",
		"react": "19.2.3",
		"vitest": "4.0.16"
	},
	"keywords": [
		"trust",
		"connect",
		"sdk",
		"walletconnect",
		"xpla",
		"vault",
		"mobile"
	],
	"author": "",
	"license": "Apache-2.0"
}
